<launch>
    <arg name="map_yaml"/>
    <arg name="params_file" default="$(find-pkg-share mapless_dataset)/config/nav2_params_justina.yaml"/>
    <arg name="use_sim_time" default="true"/>
    <arg name="autostart" default="true"/>

    <!-- Map server -->
    <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen">
        <param name="yaml_filename" value="$(var map_yaml)"/>
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>

    <!-- Relay /map -> /navigation/augmented_map for RViz.
        Preserves TRANSIENT_LOCAL durability. -->
    <node pkg="mapless_dataset" exec="Nav2_map_relay.py" name="map_relay" output="screen">
        <param name="in_topic" value="/map"/>
        <param name="out_topic" value="/navigation/augmented_map"/>
    </node>

    <!-- AMCL. The scan topic is set via the params file. -->
    <node pkg="nav2_amcl" exec="amcl" name="amcl" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var params_file)"/>
    </node>

    <!-- Planner server -->
    <node pkg="nav2_planner" exec="planner_server" name="planner_server" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var params_file)"/>
    </node>

    <!-- Smoother server -->
    <node pkg="nav2_smoother" exec="smoother_server" name="smoother_server" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var params_file)"/>
    </node>

    <!-- Controller server. Publishes cmd_vel. -->
    <node pkg="nav2_controller" exec="controller_server" name="controller_server" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var params_file)"/>
    </node>

    <!-- Behavior server -->
    <node pkg="nav2_behaviors" exec="behavior_server" name="behavior_server" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var params_file)"/>
    </node>

    <!-- BT navigator -->
    <node pkg="nav2_bt_navigator" exec="bt_navigator" name="bt_navigator" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var params_file)"/>
    </node>

    <!-- Waypoint follower -->
    <node pkg="nav2_waypoint_follower" exec="waypoint_follower" name="waypoint_follower" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var params_file)"/>
    </node>

    <!-- Velocity smoother: cmd_vel -> cmd_vel_smoothed -->
    <node pkg="nav2_velocity_smoother" exec="velocity_smoother" name="velocity_smoother" output="screen" respawn="true">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param from="$(var params_file)"/>
    </node>

    <!-- Relay: cmd_vel_smoothed -> /hardware/base/cmd_vel.
       topic_tools adds ~1 ms latency, negligible at 20 Hz. -->
    <node pkg="topic_tools" exec="relay" name="cmd_vel_relay" output="screen" args="/cmd_vel_smoothed /hardware/base/cmd_vel"/>

    <!-- Lifecycle manager -->
    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="autostart" value="$(var autostart)"/>
        <param name="node_names" value="['map_server', 'amcl', 'controller_server', 'smoother_server', 'planner_server', 'behavior_server', 'bt_navigator', 'waypoint_follower', 'velocity_smoother']"/>
        <param name="bond_timeout" value="4.0"/>
    </node>
</launch>