<launch>
    <arg name="use_sim_time" default="true"/>
    <arg name="use_pot_fields" default="true"/>
    <arg name="max_linear_speed" default="0.9"/>
    <arg name="max_angular_speed" default="0.6"/>
    <arg name="cmd_vel_topic" default="/hardware/base/cmd_vel"/>
    <arg name="goal_dmax_tolerance" default="0.40"/>

<node pkg="navigation_controller" exec="simple_move_node"
          name="simple_move" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="max_linear_speed" value="$(var max_linear_speed)"/>
        <param name="min_linear_speed" value="0.05"/>
        <param name="max_angular_speed" value="$(var max_angular_speed)"/>
        <param name="control_alpha" value="0.8"/>
        <param name="control_beta" value="0.15"/>         <!-- 0.5 a 0.15 para mayor firmeza angular -->
        <param name="linear_acceleration" value="0.1"/>
        <param name="fine_dist_tolerance" value="0.03"/>
        <param name="goal_dmin_tolerance" value="0.20"/>
        <param name="goal_dmax_tolerance" value="$(var goal_dmax_tolerance)"/>
        <param name="final_approach_radius" value="0.50"/>
        <param name="path_lookahead_m" value="0.15"/>        <!-- 0.25 a 0.15 para evitar cortar esquinas -->
        <param name="angle_tolerance" value="0.05"/>
        <param name="final_align_angle_tol" value="0.20"/>
        <param name="turn_speed_far_m" value="1.5"/>
        <param name="turn_speed_near_m" value="0.7"/>
        <param name="turn_speed_factor_far" value="0.6"/>
        <param name="turn_speed_factor_near" value="0.25"/>  <!-- 0.35 a 0.25 para frenar más en curvas -->
        <param name="use_pot_fields" value="$(var use_pot_fields)"/>
        <param name="base_link_name" value="base_link"/>
        <param name="cmd_vel_topic" value="$(var cmd_vel_topic)"/>
        <param name="flip_forward_sign" value="false"/>
        <param name="flip_lateral_sign" value="false"/>
        <param name="flip_angular_sign" value="false"/>
    </node>

<node pkg="navigation_controller" exec="obs_detect_node"
          name="obs_detect" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="use_lidar" value="true"/>
        <param name="use_point_cloud" value="true"/>
        <param name="use_pot_fields" value="$(var use_pot_fields)"/>
        <param name="pot_fields_k_rej" value="0.2"/>        <!-- 0.3 a 0.4 (fuerza de repulsión de los muros) -->
        <param name="pot_fields_d0" value="1.1"/>           <!-- 1.0 a 1.1 (Detecta y reacciona a los obstáculos antes) -->
        <param name="lidar_points_threshold" value="15"/>
        <param name="lidar_downsampling" value="1"/>
        <param name="cloud_points_threshold" value="40"/>  <!-- 80 a 40 para aceptar clústeres más pequeños (patas) -->
        <param name="cloud_downsampling" value="2"/>       <!-- 9 a 2 (Preserva los puntos de objetos finos) -->
        <param name="min_x" value="0.35"/>
        <param name="max_x" value="0.55"/>
        <param name="min_y" value="-0.20"/>
        <param name="max_y" value="0.20"/>
        <param name="min_z" value="0.05"/>
        <param name="max_z" value="1.50"/>
        <param name="laser_scan_topic" value="/hardware/base/scan"/>
        <param name="point_cloud_topic" value="/hardware/camera/points"/>
        <param name="base_link_name" value="base_link"/>
        <param name="debug" value="false"/>
    </node>
</launch>