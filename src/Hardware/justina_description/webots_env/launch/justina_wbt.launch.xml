<launch>
  <!-- ===================== -->
  <!--   Global Arguments    -->
  <!-- ===================== -->
  <arg name="use_sim_time" default="true"/>

  <arg name="namespace_supervisor"   default="supervisor"/>
  <arg name="namespace_executor"     default="executor"/>
  <arg name="namespace_planning"     default="planning"/>
  <arg name="namespace_navigation"   default="navigation"/>
  <arg name="namespace_manipulation" default="manipulation"/>
  <arg name="namespace_hardware"     default="hardware"/>
  <arg name="namespace_hri"          default="hri"/>
  <arg name="namespace_vision"          default="vision"/>
  <arg name="namespace_tasks"          default="tasks"/>

  <arg name="use_nav" default="true"/>

  <!-- ================================= -->
  <!--   Virtual Environment Arguments   -->
  <!-- ================================= -->

  <!-- Get the package share directory -->
  <let name="package_share" value="$(find-pkg-share justina_description)" />
  <!-- Arguments for initial pose -->
  <arg name="initial_pose_x" default="6.5" description="Initial X position (map frame)"/>
  <arg name="initial_pose_y" default="3.2" description="Initial Y position (map frame)"/>
  <arg name="initial_pose_yaw" default="0.0" description="Initial yaw angle (radians)"/>


  <!-- ================= Launch Webots ================= -->
  <let name="world_path" value="$(var package_share)/webots_env/worlds/configuring_robot.wbt" />
  <let name="controllers_path" value="$(var package_share)/webots_env/controllers" />

  <executable cmd="webots --mode=realtime $(var world_path)" output="screen">
    <env name="WEBOTS_CONTROLLER_PATH" value="$(var controllers_path)" />
    <env name="DISPLAY" value="$(env DISPLAY :0)" />
  </executable>

  <!-- ========== Point Cloud Node ========== -->
  <node pkg="justina_description" exec="depth_to_pointcloud" name="depth_to_pointcloud" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="max_frequency" value="15.0" />
    <param name="min_depth" value="0.1" />
    <param name="max_depth" value="8.0" />
    <param name="downsample_step" value="2" />
  </node>

  <!-- ========== RViz custom config ========== -->
  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(var package_share)/webots_env/rviz/justina_wbt.rviz">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  
  <node pkg="justina_description" exec="set_initial_pose.py" name="set_initial_pose" output="screen"
        args="--x $(var initial_pose_x) --y $(var initial_pose_y) --yaw $(var initial_pose_yaw)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- ========== JOYSTICK ========== -->
  <node pkg="joy" exec="joy_node" name="joy_node" output="screen">
    <remap from="joy" to="/hardware/joy"/>
  </node>
  <node pkg="justina_description" exec="robot_teleop.py" name="robot_teleop" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- =============== robot_state_publisher =============== -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'cat $(var package_share)/urdf/justina.urdf')" />
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="joint_states" to="/hardware/joint_states"/>
    <remap from="robot_description" to="/hardware/robot_description"/>
  </node>



  <!-- ========== Static transform from map to odom ========== -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="map_to_odom" args="--x 0 --y 0 --z 0 --roll 0 --pitch 0 --yaw 0 --frame-id map --child-frame-id odom">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>




  <!-- TODO: Use sim time in all nodes and launch files -->

  <!-- ===================== -->
  <!--      Supervisor       -->
  <!-- ===================== -->
  <include file="$(find-pkg-share supervisor_manager)/launch/supervisor.launch.xml">
    <arg name="namespace" value="$(var namespace_supervisor)"/>
  </include>

  <!-- ===================== -->
  <!--       Executor        -->
  <!-- ===================== -->
  <include file="$(find-pkg-share executor_tools)/launch/executor.launch.xml">
    <arg name="namespace" value="$(var namespace_executor)"/>
  </include>

  <!-- ===================== -->
  <!--       Planning        -->
  <!-- ===================== -->
  <include file="$(find-pkg-share planning_tools)/launch/planning.launch.xml">
    <arg name="namespace" value="$(var namespace_planning)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <!-- ===================== -->
  <!--      Navigation       -->
  <!-- ===================== -->
  <include file="$(find-pkg-share navigation_tools)/launch/navigation.launch.xml"
           if="$(var use_nav)">
    <arg name="namespace_nav" value="$(var namespace_navigation)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

  <!-- ===================== -->
  <!--     Manipulation      -->
  <!-- ===================== -->
  <include file="$(find-pkg-share manipulation_tools)/launch/manipulation.launch.xml">
    <arg name="namespace" value="$(var namespace_manipulation)"/>
  </include>

  <!-- ===================== -->
  <!--       Hardware        -->
  <!-- ===================== -->
  <include file="$(find-pkg-share hardware_tools)/launch/hardware.launch.xml">
    <arg name="namespace" value="$(var namespace_hardware)"/>
  </include>

  <!-- ===================== -->
  <!--         HRI           -->
  <!-- ===================== -->
  <include file="$(find-pkg-share hri_tools)/launch/hri.launch.xml">
    <arg name="namespace" value="$(var namespace_hri)"/>
  </include>

  <!-- ===================== -->
  <!--        Vision         -->
  <!-- ===================== -->
  <include file="$(find-pkg-share vision_tools)/launch/vision.launch.xml">
    <arg name="namespace" value="$(var namespace_vision)"/>
  </include>



</launch>


