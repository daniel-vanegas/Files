DEF MainCameraController Robot {
  controller "camera_controller"
  supervisor TRUE
  translation 0 1.5 1.6
  rotation 0 0 1 0
  children [
    DEF CAMERA_PITCH Transform {
      # Initial rotation: set to identity (no pitch) – we will adjust this later
      rotation 0 1 0 0
      children [
        # Solid wrapper for camera (invisible)
        Solid {
          translation 0 0 0
          children [
            Shape {
              appearance PBRAppearance {
                baseColor 0 0 0
                transparency 1
              }
              geometry Box { size 0.01 0.01 0.01 }
            }
            # Camera device – keep its rotation exactly as you had it (the one that works)
            Camera {
              name "CAMERA"
              width 1280
              height 720
              fieldOfView 0.785398
              translation 0 0 0
              rotation 0 0 1 0
            }
          ]
        }
      ]
    }
  ]
}



