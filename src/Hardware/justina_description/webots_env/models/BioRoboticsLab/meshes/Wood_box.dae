  <library_effects>
    <effect id="Material-effect">
      <profile_COMMON>
        <newparam sid="Wood_Pinted_White_albedo_jpg-surface">
          <surface type="2D">
            <init_from>Wood_Pinted_White_albedo_jpg</init_from>
          </surface>
        </newparam>
        <newparam sid="Wood_Pinted_White_albedo_jpg-sampler">
          <sampler2D>
            <source>Wood_Pinted_White_albedo_jpg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Wood_Pinted_White_albedo_jpg-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
