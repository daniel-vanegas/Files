<?xml version="1.0"?>
<robot name="justina">

  <!-- Materials -->
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- ==================== LINKS ==================== -->

  <!-- base_link (the robot itself) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <mass value="23.0"/>
      <inertia ixx="0.589" ixy="0.0" ixz="0.0" iyy="0.589" iyz="0.0" izz="0.958"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://justina_description/meshes/justina/Base_ROBOTINO_B.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://justina_description/meshes/justina/Base_Collider_ROBOTINO_B.dae"/>
      </geometry>
    </collision>
  </link>

  <!-- laser_link -->
  <link name="laser_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://justina_description/meshes/robotino/sensors/Hokuyo_Clean.dae"/>
      </geometry>
      <material name="grey"/>
    </visual><box size="0.05 0.05455 0.07"/>
    <collision>
      <origin xyz="0 -0.002 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05455 0.07"/>
      </geometry>
    </collision>
  </link>

  <!-- body_link -->
  <link name="body_link">
    <inertial>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <mass value="5.5"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://justina_description/meshes/justina/Body_ROBOTINO_B.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://justina_description/meshes/justina/Body_Collider_ROBOTINO_B.dae"/>
      </geometry>
    </collision>
  </link>

