  <!-- ==================== JOINTS ==================== -->
  <!-- Connect body_link to base_link -->
  <joint name="base_to_body" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="0 0 0.315" rpy="0 0 0"/>
  </joint>

  <!-- laser_link is fixed to base_link -->
  <joint name="laser_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.06 0 0.1975" rpy="0 0 0"/>
  </joint>

  <!-- torso prismatic joint -->
  <joint name="torso_joint" type="prismatic">
    <parent link="body_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.3014" effort="15" velocity="12"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- spine_link fixed to torso_link -->
  <joint name="spine_fixed_joint" type="fixed">
    <parent link="torso_link"/>
    <child link="spine_link"/>
    <origin xyz="0 0 0.5187" rpy="0 0 0"/>
  </joint>

  <!-- fixed joint for right_shoulder_link relative to spine_link -->
  <joint name="right_shoulder_fixed" type="fixed">
    <parent link="spine_link"/>
    <child link="right_shoulder_link"/>
    <origin xyz="0 -0.224765 0" rpy="0 0 0"/>
  </joint>

  <!-- right arm joints -->
  <joint name="rf_shoulder_joint" type="revolute">
    <parent link="right_shoulder_link"/>
    <child link="rf_frame_link"/>
    <origin xyz="0 0 -0.0608" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="rs_shoulder_joint" type="revolute">
    <parent link="rf_frame_link"/>
    <child link="r_arm_link"/>
    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="r_arm_twist_joint" type="revolute">
    <parent link="r_arm_link"/>
    <child link="r_arm_twist_link"/>
    <origin xyz="0 0 -0.09" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="r_elbow_joint" type="revolute">
    <parent link="r_arm_twist_link"/>
    <child link="r_forearm_link"/>
    <origin xyz="0 0 -0.07" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="r_wrist_joint" type="revolute">
    <parent link="r_forearm_link"/>
    <child link="r_wrist_link"/>
    <origin xyz="0 0 -0.09" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="r_hand_joint" type="revolute">
    <parent link="r_wrist_link"/>
    <child link="r_hand_link"/>
    <origin xyz="0 0 -0.07" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="right_gripper_L_joint" type="revolute">
    <parent link="r_hand_link"/>
    <child link="right_gripper_L_link"/>
    <origin xyz="-0.005904 0.01614 -0.13759" rpy="0 0 -1.5708"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="right_gripper_R_joint" type="revolute">
    <parent link="r_hand_link"/>
    <child link="right_gripper_R_link"/>
    <origin xyz="-0.005904 -0.01614 -0.13759" rpy="0 0 1.5708"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="right_grab_joint" type="fixed">
    <parent link="r_hand_link"/>
    <child link="right_grab_object_link"/>
    <origin xyz="-0.005904 0 -0.237746" rpy="0 0 0"/>
  </joint>

  <joint name="right_pinch_joint" type="fixed">
    <parent link="r_hand_link"/>
    <child link="right_pinch_object_link"/>
    <origin xyz="-0.005904 0 -0.267347" rpy="0 0 0"/>
  </joint>  

  <!-- fixed joint for left_shoulder_link relative to spine_link -->
  <joint name="left_shoulder_fixed" type="fixed">
    <parent link="spine_link"/>
    <child link="left_shoulder_link"/>
    <origin xyz="0 0.224765 0" rpy="0 0 0"/>
  </joint>

  <!-- left arm joints -->
  <joint name="lf_shoulder_joint" type="revolute">
    <parent link="left_shoulder_link"/>
    <child link="lf_frame_link"/>
    <origin xyz="0 0 -0.0608" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="ls_shoulder_joint" type="revolute">
    <parent link="lf_frame_link"/>
    <child link="l_arm_link"/>
    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="l_arm_twist_joint" type="revolute">
    <parent link="l_arm_link"/>
    <child link="l_arm_twist_link"/>
    <origin xyz="0 0 -0.09" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="l_elbow_joint" type="revolute">
    <parent link="l_arm_twist_link"/>
    <child link="l_forearm_link"/>
    <origin xyz="0 0 -0.07" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="l_wrist_joint" type="revolute">
    <parent link="l_forearm_link"/>
    <child link="l_wrist_link"/>
    <origin xyz="0 0 -0.09" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="l_hand_joint" type="revolute">
    <parent link="l_wrist_link"/>
    <child link="l_hand_link"/>
    <origin xyz="0 0 -0.07" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="left_gripper_L_joint" type="revolute">
    <parent link="l_hand_link"/>
    <child link="left_gripper_L_link"/>
    <origin xyz="-0.005904 0.01614 -0.13759" rpy="0 0 -1.5708"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="left_gripper_R_joint" type="revolute">
    <parent link="l_hand_link"/>
    <child link="left_gripper_R_link"/>
    <origin xyz="-0.005904 -0.01614 -0.13759" rpy="0 0 1.5708"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="left_grab_joint" type="fixed">
    <parent link="l_hand_link"/>
    <child link="left_grab_object_link"/>
    <origin xyz="-0.005904 0 -0.237746" rpy="0 0 0"/>
  </joint>

  <joint name="left_pinch_joint" type="fixed">
    <parent link="l_hand_link"/>
    <child link="left_pinch_object_link"/>
    <origin xyz="-0.005904 0 -0.267347" rpy="0 0 0"/>
  </joint>  

  <!-- fixed joint for neck_link relative to spine_link -->
  <joint name="neck_fixed" type="fixed">
    <parent link="spine_link"/>
    <child link="neck_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- head joints -->
  <joint name="head_pan_joint" type="revolute">
    <parent link="neck_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 0.143" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <joint name="head_tilt_joint" type="revolute">
    <parent link="head_link"/>
    <child link="head_frame_link"/>
    <origin xyz="0 0 0.057" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.7" upper="1.7" effort="16" velocity="3"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- camera fixed to head_frame_link -->
  <joint name="camera_fixed_joint" type="fixed">
    <parent link="head_frame_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.1275" rpy="-1.5707 0 -1.5707"/>
  </joint>

  <!-- ================= CAMERA FRAMES ================= -->

  <!-- Color camera frame -->
  <link name="camera_color_frame"/>

  <joint name="camera_color_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Color optical frame (REP 103 standard) -->
  <link name="camera_color_optical_frame"/>

  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>


  <!-- Depth camera frame -->
  <link name="camera_depth_frame"/>

  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Depth optical frame (REP 103 standard) -->
  <link name="camera_depth_optical_frame"/>

  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- wheel joints (continuous) -->
  <!-- All wheels are oriented with their rotation axis along 
  the y-axis of the wheel link, and the wheel links are positioned 
  such that the center of each wheel is at the specified xyz 
  coordinates in the origin tag of each joint. The rpy values in 
  the origin tags are set to orient the wheels correctly based on 
  their positions around the base_link. -->

  <!-- wheel0 (at angle 60°) -->
  <joint name="wheel0_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel0_link"/>
    <origin xyz="0.09 0.155885 0.06" rpy="0 0 -0.523599"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- wheel1 (at angle 180°) -->
  <joint name="wheel1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel1_link"/>
    <origin xyz="-0.18 0 0.06" rpy="0 0 1.5708"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.1"/>
  </joint>

  <!-- wheel2 (at angle 300° or -60°) -->
  <joint name="wheel2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel2_link"/>
    <origin xyz="0.09 -0.155885 0.06" rpy="0 0 -2.61799"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.1"/>
  </joint>

</robot>
