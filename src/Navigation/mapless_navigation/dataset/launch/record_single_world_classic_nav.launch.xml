<launch>
    <arg name="world" default="E01"/>
    <arg name="scenario" default="$(var world)"/>
    <arg name="maps_root" default="$(find-pkg-share justina_description)/webots_env/environments/maps"/>

    <arg name="map_folder" default="$(command 'find $(var maps_root) -maxdepth 1 -mindepth 1 -type d -name $(var world)_* -printf %f')"/>

    <arg name="map_variant" default="prohibition"/>
    <arg name="map_yaml" default="$(var maps_root)/$(var map_folder)/map_$(var map_folder)_$(var map_variant).yaml"/>
    <arg name="prohibition_png" default="$(var maps_root)/$(var map_folder)/map_$(var map_folder)_prohibition.png"/>

    <arg name="initial_pose_x" default="0.0"/>
    <arg name="initial_pose_y" default="0.0"/>
    <arg name="initial_pose_yaw" default="0.0"/>
    <arg name="world_offset_x" default="0.0"/>
    <arg name="world_offset_y" default="0.0"/>
    <arg name="world_offset_yaw" default="0.0"/>
    <arg name="auto_world_offset" default="true"/>
    <arg name="teacher" default="classic_nav"/>
    <arg name="seed" default="-1"/>
    <arg name="num_goals" default="100"/>
    <arg name="max_attempts_per_goal" default="2"/>
    <arg name="goal_timeout_s" default="60.0"/>
    <arg name="goal_position_tolerance_m" default="0.40"/>
    <arg name="goal_pause_s" default="0.5"/>
    <arg name="min_attempt_s" default="3.0"/>
    <arg name="min_goal_interval_s" default="1.0"/>
    <arg name="max_consecutive_fast_fails" default="10"/>
    <arg name="post_teleport_settle_s" default="1.5"/>
    <arg name="post_teleport_amcl_grace_s" default="3.0"/>
    <arg name="record_hz" default="5.0"/>
    <arg name="teleport_at_start" default="true"/>
    <arg name="output_dir" default="src/Navigation/mapless_navigation/dataset/data"/>
    <arg name="use_path_pool" default="true"/>
    <arg name="pool_max_retries" default="3"/>
    <arg name="rviz" default="true"/>

    <arg name="path_max_attempts" default="3"/>
    <arg name="collision_settle_s" default="1.5"/>

    <arg name="room_radius_m" default="0.45"/>
    <arg name="min_room_area_m2" default="0.5"/>
    <arg name="zone_bin_m" default="0.8"/>
    <arg name="recent_zone_window" default="8"/>
    <arg name="max_goals_per_room" default="6"/>
    <arg name="recent_room_window" default="3"/>
    <arg name="veto_room_duration_s" default="90.0"/>
    <arg name="veto_room_min_fails" default="3"/>

    <arg name="instant_fail_threshold_s" default="0.5"/>
    <arg name="max_instant_fails" default="3"/>

    <arg name="post_teleport_clear_costmap" default="false"/>
    <arg name="post_teleport_costmap_clear_wait_s" default="0.0"/>
    <arg name="post_teleport_nav_settle_s" default="1.5"/>
    <arg name="costmap_clear_service_timeout_s" default="2.0"/>

    <arg name="stuck_window_s" default="2.0"/>
    <arg name="stuck_eps_pos_m" default="0.02"/>
    <arg name="stuck_eps_yaw_rad" default="0.10"/>
    <arg name="stuck_eps_cmd_lin" default="0.05"/>
    <arg name="stuck_eps_cmd_ang" default="0.10"/>
    <arg name="stuck_min_duration_s" default="1.5"/>
    <arg name="collision_lookback_frames" default="5"/>
    <arg name="stuck_lookback_frames" default="5"/>

    <arg name="camera_publish_hz" default="10.0"/>
    <arg name="camera_enable" default="true"/>
    <arg name="scan_publish_divider" default="2"/>

    <let name="pkg_justina" value="$(find-pkg-share justina_description)"/>
    <let name="pkg_dataset" value="$(find-pkg-share mapless_dataset)"/>

    <executable cmd="webots --mode=realtime --batch $(var pkg_justina)/webots_env/worlds/$(var world).wbt" output="screen">
        <env name="WEBOTS_CONTROLLER_PATH" value="$(var pkg_justina)/webots_env/controllers"/>
        <env name="JUSTINA_CAMERA_HZ" value="$(var camera_publish_hz)"/>
        <env name="JUSTINA_CAMERA_ENABLE" value="$(var camera_enable)"/>
        <env name="JUSTINA_SCAN_DIVIDER" value="$(var scan_publish_divider)"/>
    </executable>

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'cat $(var pkg_justina)/urdf/justina.urdf')"/>
        <param name="use_sim_time" value="true"/>
        <remap from="joint_states" to="/hardware/joint_states"/>
        <remap from="robot_description" to="/hardware/robot_description"/>
    </node>

    <node pkg="justina_description" exec="depth_to_pointcloud" name="depth_to_pointcloud" output="screen">
        <param name="use_sim_time" value="true"/>
        <param name="max_frequency" value="15.0"/>
        <param name="min_depth" value="0.1"/>
        <param name="max_depth" value="8.0"/>
        <param name="downsample_step" value="2"/>
        <param name="floor_filter_enable" value="true"/>
        <param name="floor_z_m" value="0.15"/>
        <param name="map_frame" value="map"/>
    </node>

    <node pkg="justina_description" exec="set_initial_pose.py" name="set_initial_pose" output="screen" args="--x $(var initial_pose_x) --y $(var initial_pose_y) --yaw $(var initial_pose_yaw)">
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="mapless_nav" exec="local_occ_grid_node" name="local_occ_grid_nav" output="screen">
        <param name="use_sim_time" value="true"/>
        <param name="frame_id" value="base_link"/>
        <param name="map_topic" value="/mapless/local_occ_grid"/>
        <param name="min_x" value="0.0"/>
        <param name="max_x" value="4.0"/>
        <param name="min_y" value="-2.0"/>
        <param name="max_y" value="2.0"/>
        <param name="min_z" value="0.06"/>
        <param name="max_z" value="2.0"/>
        <param name="resolution" value="0.05"/>
        <param name="lidar_downsample" value="2"/>
        <param name="cloud_downsample" value="2"/>
        <param name="use_lidar" value="true"/>
        <param name="use_cloud" value="true"/>
    </node>

    <node pkg="mapless_dataset" exec="prohibition_map_publisher.py" name="prohibition_map_publisher" output="screen">
        <param name="use_sim_time" value="true"/>
        <param name="map_yaml" value="$(var maps_root)/$(var map_folder)/map_$(var map_folder)_prohibition.yaml"/>
        <param name="topic_name" value="/navigation/prohibition_map"/>
        <param name="frame_id" value="map"/>
    </node>

    <node pkg="mapless_nav" exec="get_goal_point" name="get_goal_point" output="screen">
        <param name="use_sim_time" value="true"/>
        <param name="goal_topic" value="/mapless_nav/recording_goal"/>
        <param name="output_topic" value="/NN_goal"/>
        <param name="robot_frame" value="base_link"/>
    </node>

    <node pkg="nav2_map_server" exec="map_server" name="map_server" output="screen">
        <param name="use_sim_time" value="true"/>
        <param name="yaml_filename" value="$(var map_yaml)"/>
    </node>

    <node pkg="nav2_amcl" exec="amcl" name="amcl" output="screen">
        <param name="use_sim_time" value="true"/>
        <param name="alpha1" value="0.2"/>
        <param name="alpha2" value="0.2"/>
        <param name="alpha3" value="0.2"/>
        <param name="alpha4" value="0.2"/>
        <param name="alpha5" value="0.2"/>
        <param name="base_frame_id" value="base_link"/>
        <param name="global_frame_id" value="map"/>
        <param name="odom_frame_id" value="odom"/>
        <param name="scan_topic" value="/hardware/base/scan"/>
        <param name="robot_model_type" value="nav2_amcl::OmniMotionModel"/>
        <param name="laser_model_type" value="likelihood_field"/>
        <param name="min_particles" value="500"/>
        <param name="max_particles" value="2000"/>
        <param name="update_min_d" value="0.05"/>
        <param name="update_min_a" value="0.05"/>
        <param name="transform_tolerance" value="1.0"/>
        <param name="tf_broadcast" value="true"/>
        <param name="set_initial_pose" value="true"/>
        <param name="initial_pose.x" value="$(var initial_pose_x)"/>
        <param name="initial_pose.y" value="$(var initial_pose_y)"/>
        <param name="initial_pose.z" value="0.0"/>
        <param name="initial_pose.yaw" value="$(var initial_pose_yaw)"/>
    </node>

    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_localization" output="screen">
        <param name="use_sim_time" value="true"/>
        <param name="autostart" value="true"/>
        <param name="node_names" value="['map_server', 'amcl']"/>
    </node>

    <include file="$(find-pkg-share navigation_planner)/launch/navigation.launch.xml">
        <arg name="use_sim_time" value="true"/>
        <arg name="use_pot_fields" value="true"/>
        <arg name="patience" value="false"/>
        <arg name="goal_dmax_tolerance" value="$(var goal_position_tolerance_m)"/>
    </include>

    <node pkg="topic_tools" exec="relay" name="goal_relay" output="screen" args="/clicked_point /mapless_nav/current_goal"/>

    <node pkg="mapless_dataset" exec="random_goal_sampler.py" name="random_goal_sampler" output="screen">
        <param name="use_sim_time" value="true"/>
        <param name="navigation_backend" value="classic"/>
        <param name="prohibition_png" value="$(var maps_root)/$(var map_folder)/map_$(var map_folder)_prohibition.png"/>
        <param name="scenario" value="$(var scenario)"/>
        <param name="output_dir" value="$(var output_dir)"/>
        <param name="use_path_pool" value="$(var use_path_pool)"/>
        <param name="pool_min_clearance_m" value="0.15"/>
        <param name="pool_max_retries" value="$(var pool_max_retries)"/>
        <param name="num_goals" value="$(var num_goals)"/>
        <param name="map_wait_timeout_s" value="20.0"/>
        <param name="max_attempts_per_goal" value="$(var max_attempts_per_goal)"/>
        <param name="goal_timeout_s" value="$(var goal_timeout_s)"/>
        <param name="goal_pause_s" value="$(var goal_pause_s)"/>
        <param name="min_attempt_s" value="$(var min_attempt_s)"/>
        <param name="min_goal_interval_s" value="$(var min_goal_interval_s)"/>
        <param name="max_consecutive_fast_fails" value="$(var max_consecutive_fast_fails)"/>

        <param name="path_max_attempts" value="$(var path_max_attempts)"/>
        <param name="collision_settle_s" value="$(var collision_settle_s)"/>

        <param name="seed" value="$(var seed)"/>
        <param name="teleport_at_start" value="$(var teleport_at_start)"/>
        <param name="world_offset_x" value="$(var world_offset_x)"/>
        <param name="world_offset_y" value="$(var world_offset_y)"/>
        <param name="world_offset_yaw" value="$(var world_offset_yaw)"/>
        <param name="auto_world_offset" value="$(var auto_world_offset)"/>
        <param name="post_teleport_clear_costmap" value="true"/>
        <param name="post_teleport_costmap_clear_wait_s" value="0.5"/>
        <param name="post_teleport_settle_s" value="1.5"/>
        <param name="post_teleport_nav_settle_s" value="1.5"/>
        <param name="post_teleport_amcl_grace_s" value="2.0"/>
        <param name="amcl_stable_tolerance_m" value="0.05"/>

        <param name="room_radius_m" value="$(var room_radius_m)"/>
        <param name="min_room_area_m2" value="$(var min_room_area_m2)"/>
        <param name="zone_bin_m" value="$(var zone_bin_m)"/>
        <param name="recent_zone_window" value="$(var recent_zone_window)"/>
        <param name="max_goals_per_room" value="3"/>
        <param name="recent_room_window" value="5"/>
        <param name="veto_room_duration_s" value="$(var veto_room_duration_s)"/>
        <param name="veto_room_min_fails" value="$(var veto_room_min_fails)"/>
        <param name="min_goal_distance_m" value="2.0"/>
        <param name="max_goal_distance_m" value="3.0"/>
        <param name="max_euclidean_goal_distance_m" value="3.0"/>
        <param name="max_path_length_m" value="3.0"/>
        <param name="goal_position_tolerance_m" value="$(var goal_position_tolerance_m)"/>
        <param name="plan_service_name" value="/path_planner/plan_path_with_augmented"/>
        <param name="candidate_attempts_per_class" value="120"/>
    </node>

    <node pkg="mapless_dataset" exec="dataset_recorder" name="dataset_recorder" output="screen">
        <param name="use_sim_time" value="true"/>
        <param name="output_dir" value="$(var output_dir)"/>
        <param name="scenario" value="$(var scenario)"/>
        <param name="teacher" value="$(var teacher)"/>
        <param name="record_hz" value="$(var record_hz)"/>
        <param name="max_goals" value="$(var num_goals)"/>
        <param name="costmap_topic" value="/mapless/local_occ_grid"/>
        <param name="cmd_vel_topic" value="/hardware/base/cmd_vel"/>
        <param name="nn_goal_topic" value="/NN_goal"/>
        <param name="current_goal_topic" value="/mapless_nav/recording_goal"/>
        <param name="goal_active_topic" value="/mapless_nav/goal_active"/>
        <param name="episode_id_topic" value="/mapless_nav/episode_id"/>
        <param name="episode_tries_topic" value="/mapless_nav/episode_tries"/>
        <param name="episode_class_topic" value="/mapless_nav/episode_class"/>
        <param name="goal_success_topic" value="/mapless_nav/goal_success"/>
        <param name="collision_topic" value="/navigation/collision"/>
        <param name="stuck_window_s" value="$(var stuck_window_s)"/>
        <param name="stuck_eps_pos_m" value="$(var stuck_eps_pos_m)"/>
        <param name="stuck_eps_yaw_rad" value="$(var stuck_eps_yaw_rad)"/>
        <param name="stuck_eps_cmd_lin" value="$(var stuck_eps_cmd_lin)"/>
        <param name="stuck_eps_cmd_ang" value="$(var stuck_eps_cmd_ang)"/>
        <param name="stuck_min_duration_s" value="$(var stuck_min_duration_s)"/>
        <param name="collision_lookback_frames" value="$(var collision_lookback_frames)"/>
        <param name="stuck_lookback_frames" value="$(var stuck_lookback_frames)"/>
    </node>

    <group if="$(var rviz)">
        <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(var pkg_justina)/webots_env/rviz/justina_wbt.rviz">
            <param name="use_sim_time" value="true"/>
        </node>
    </group>
</launch>